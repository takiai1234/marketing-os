# =============================================================================
# Marketing OS — Production Environment Variables
#
# USAGE:
#   cp .env.production.example .env.production
#   chmod 600 .env.production        # root-only read
#   # Fill in every <placeholder> value before starting containers
#
# SECURITY: NEVER commit .env.production to git. It is in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Postgres 16 (service name "postgres" inside Docker network)
# -----------------------------------------------------------------------------

# Postgres superuser for this database
DB_USER=marketing

# Strong random password (min 24 chars): openssl rand -base64 32
DB_PASSWORD=<strong-random-password>

# Database name
DB_NAME=marketing_os

# Full connection URL used by the app and migration runner.
# Host is "postgres" — the Docker Compose service name on the internal network.
DATABASE_URL=postgresql://marketing:<DB_PASSWORD>@postgres:5432/marketing_os

# -----------------------------------------------------------------------------
# Session & Encryption
# -----------------------------------------------------------------------------

# iron-session encryption password (min 32 chars): openssl rand -hex 32
SESSION_PASSWORD=<openssl-rand-hex-32>

# AES encryption key for stored FB tokens (32-byte hex): openssl rand -hex 32
ENCRYPTION_KEY=<openssl-rand-hex-32>

# -----------------------------------------------------------------------------
# Facebook / Meta App
# -----------------------------------------------------------------------------

# From Meta Developer Console → App Dashboard → App ID
FB_APP_ID=

# From Meta Developer Console → App Dashboard → App Secret
FB_APP_SECRET=

# Must match the Valid OAuth Redirect URI configured in Meta App Settings.
# Replace <domain> with your actual domain.
FB_REDIRECT_URI=https://<domain>/api/auth/fb/callback

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------

# Canonical app URL — used for building absolute links (FB redirect, emails, etc.)
APP_URL=https://<domain>

# Exposed to browser via Next.js NEXT_PUBLIC_ prefix
NEXT_PUBLIC_APP_URL=https://<domain>

# Your actual domain (used by certbot block in docker-compose.yml)
DOMAIN=<domain>

# -----------------------------------------------------------------------------
# Admin account
# -----------------------------------------------------------------------------

# Admin login email
ADMIN_EMAIL=admin@taki.vn

# Bcrypt hash of admin password.
# Generate with: docker compose run --rm app node -e "
#   const b = require('bcryptjs');
#   b.hash('YourPassword123!', 12).then(h => console.log(h));
# "
# Or use the helper script: docker compose run --rm app node scripts/hash-password.js
ADMIN_PASSWORD_HASH=<bcrypt-hash>

# -----------------------------------------------------------------------------
# Ladipage conversion sync (n8n webhook)
# -----------------------------------------------------------------------------
# Cron job D fetches conversion counts from this webhook nightly at 23:30 VN
# for every active Facebook page. The webhook expects POST + JSON body
# {"id_page": "<social_account.external_id>"} with header `api-key: <key>`.

LADIPAGE_WEBHOOK_URL=https://n8nauto.nguyentatkiem.com/webhook/cooking-ladipage-data

# Authentication key — request from API owner. Header is exactly `api-key`
# (lowercase, hyphenated). Do NOT reuse other API keys here.
LADIPAGE_API_KEY=<request-from-api-owner>

# -----------------------------------------------------------------------------
# Storage paths (persistent volumes)
# -----------------------------------------------------------------------------
# Folder bên trong container nơi file upload được lưu. Phải khớp với volume
# bind trong docker-compose.yml (host → container). Không giới hạn dung lượng
# ở app level — chỉ giới hạn bởi disk space của host.

# Skill bundle .zip uploads
SKILL_STORAGE_PATH=/app/storage/skills

# Project knowledge files (PDF/DOCX/MD/...) — tách riêng skill để dễ backup
PROJECT_STORAGE_PATH=/app/storage/projects

# Chat attachments (file + image đính kèm per message — ad-hoc)
CHAT_ATTACHMENT_STORAGE_PATH=/app/storage/chat-attachments

# -----------------------------------------------------------------------------
# Node.js runtime
# -----------------------------------------------------------------------------

NODE_ENV=production

# -----------------------------------------------------------------------------
# kie.ai API (optional — provider DUY NHẤT cho mọi feature AI)
# -----------------------------------------------------------------------------
# Unified gateway: 1 key bật cả 3 feature trong app:
#
#   1. CHAT với skill (LLM text)
#      - Claude Sonnet 4.6 / Opus 4.6-4.8 / Haiku 4.5 (Anthropic Messages API)
#      - GPT-5.5 (OpenAI Responses API)
#      - Gemini 3.1 Pro (OpenAI Chat Completions)
#
#   2. TẠO ẢNH (image generation)
#      - GPT Image 2, Nano Banana 2, Flux 2 Flex, Grok Imagine T2I
#
#   3. TẠO VIDEO (video generation, async polling)
#      - Grok Imagine T2V / I2V, Gemini Omni Video
#
# Lấy key tại https://kie.ai (account → API keys). Cost theo credits — xem
# https://docs.kie.ai/market cho bảng giá chi tiết per model.
#
# Bỏ trống → cả 3 feature ẩn (graceful degrade, không crash app).
# Admin cũng có thể set qua UI tại /settings/integrations (encrypted DB,
# ưu tiên hơn env var nếu cả 2 cùng có).
KIE_AI_API_KEY=

# Optional override — chỉ dùng khi kie.ai đổi base URL hoặc test với mock.
# Mặc định: https://api.kie.ai/api/v1
# Chat endpoints tự derive ROOT từ value này (strip /api/v1 suffix).
# KIE_AI_BASE_URL=
