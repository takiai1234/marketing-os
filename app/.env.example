DATABASE_URL=postgresql://marketing:devpass@localhost:5434/marketing_os
SESSION_PASSWORD=change_me_min_32_chars_long_secret
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:3000/api/auth/fb/callback
ENCRYPTION_KEY=change_me_32_byte_hex_for_pgcrypto
ADMIN_EMAIL=admin@taki.vn
ADMIN_PASSWORD_HASH=
NODE_ENV=development
# Canonical app URL — used for building absolute URLs (FB OAuth redirect, etc.)
APP_URL=http://localhost:3000
# Exposed to browser via Next.js NEXT_PUBLIC_ prefix
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Ladipage / n8n webhook — required for landing_page_conversion sync
# (Job D cron at 23:30 VN + manual sync piggyback). Without these, every
# Ladipage call fails with "env vars are required" and conversion data
# never lands in the DB.
LADIPAGE_WEBHOOK_URL=https://n8nauto.nguyentatkiem.com/webhook/cooking-ladipage-data
LADIPAGE_API_KEY=
# Bundle.social — kết nối đa nền tảng (TikTok, YouTube, IG, LinkedIn, Twitter...).
# Bắt buộc nếu muốn dùng tính năng multi-platform. Đăng ký tại bundle.social.
BUNDLE_API_KEY=
# Thường không cần đổi — default: https://api.bundle.social
# BUNDLE_API_BASE_URL=https://api.bundle.social
# Skill library — folder lưu file zip upload. Dev mặc định ./storage/skills,
# production dùng Docker volume bind /app/storage/skills.
SKILL_STORAGE_PATH=./storage/skills
# MCP Server bearer tokens (read-only, internal admin/Zapier/n8n).
# Format: JSON object — key = token, value = { clientId, scopes }.
# Sinh token: openssl rand -hex 16 → prefix tok_<env>_<purpose>
# Vd: MCP_BEARER_TOKENS_JSON='{"tok_dev_test":{"clientId":"dev","scopes":["read"]}}'
MCP_BEARER_TOKENS_JSON=
# OpenRouter API — unified LLM gateway cho feature "Chat với Skill"
# (Claude + GPT + Gemini + Grok + Llama qua 1 key). Bắt đầu sk-or-v1-...
# Lấy tại https://openrouter.ai/keys. Cần add credit ở openrouter.ai/credits.
# Bỏ trống → button Chat ẩn, feature tắt (graceful degrade).
# Admin có thể set qua UI tại /settings/integrations (encrypted DB).
OPENROUTER_API_KEY=
