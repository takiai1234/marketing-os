{
  "manifest_version": 3,
  "name": "FB Ads → Marketing OS",
  "version": "1.0.0",
  "description": "Quét Facebook Ads Library và đẩy về Marketing OS (Tin tức AI). Không cần Apify.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Ads → Marketing OS"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/ads/library*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.facebook.com/ads/library*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
